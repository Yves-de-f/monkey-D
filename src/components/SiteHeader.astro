---
import type { Locale } from '@/data/site';

interface Props {
  locale: Locale;
  brand: string;
  menuLabel: string;
  closeLabel: string;
  languageLabel: string;
  languageHref: string;
  nav: readonly (readonly [string, string])[];
}

const {
  locale,
  brand,
  menuLabel,
  closeLabel,
  languageLabel,
  languageHref,
  nav,
} = Astro.props;
---

<header class="site-header" data-site-header>
  <div class="site-header__bar shell">
    <button
      class="chip chip--orange site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-nav-toggle
      data-open-label={menuLabel}
      data-close-label={closeLabel}
    >
      <span aria-hidden="true" class="chip__mark">/</span>
      <span data-nav-label>{menuLabel}</span>
    </button>

    <a
      class="site-header__brand"
      href={locale === 'zh' ? '/index.html' : '/index_en.html'}
    >
      {brand}
    </a>

    <a
      class="chip chip--outline site-header__language"
      href={languageHref}
      hreflang={locale === 'zh' ? 'en' : 'zh-TW'}
    >
      {languageLabel}
      <span class="chip__globe" aria-hidden="true"></span>
    </a>
  </div>

  <nav
    class="site-header__nav"
    id="primary-navigation"
    aria-label={locale === 'zh' ? '主要選單' : 'Primary'}
    data-nav-panel
    inert
  >
    <ol class="site-header__links">
      {nav.map(([label, href]) => (
        <li>
          <a href={href} data-nav-link>
            <span>{label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = header?.querySelector('[data-nav-toggle]');
  const label = header?.querySelector('[data-nav-label]');
  const panel = header?.querySelector('[data-nav-panel]');
  const links = header?.querySelectorAll('[data-nav-link]');
  const hoverQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
  let manualOpen = false;
  let hoverOpen = false;

  const setNavigation = (open: boolean) => {
    if (
      !(toggle instanceof HTMLElement) ||
      !(label instanceof HTMLElement) ||
      !(panel instanceof HTMLElement)
    ) {
      return;
    }

    header?.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open
      ? toggle.dataset.closeLabel ?? ''
      : toggle.dataset.openLabel ?? '';
    panel.inert = !open;
  };

  toggle?.addEventListener('click', () => {
    manualOpen = !manualOpen;
    setNavigation(manualOpen || hoverOpen);
  });

  header?.addEventListener('mouseenter', () => {
    if (!hoverQuery.matches) return;
    hoverOpen = true;
    setNavigation(true);
  });

  header?.addEventListener('mouseleave', () => {
    if (!hoverQuery.matches) return;
    hoverOpen = false;
    setNavigation(manualOpen);
  });

  links?.forEach((link) =>
    link.addEventListener('click', () => {
      manualOpen = false;
      hoverOpen = false;
      setNavigation(false);
    }),
  );

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      manualOpen = false;
      hoverOpen = false;
      setNavigation(false);
    }
  });
</script>
