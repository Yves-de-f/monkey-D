---
import type { Locale, ServiceItem } from '@/data/site';

interface Props {
  item: ServiceItem;
  locale: Locale;
  linkLabel: string;
  index: number;
  layout?: 'standard' | 'feature';
}

const { item, locale, linkLabel, index, layout = 'standard' } = Astro.props;
---

<article class:list={['service-card', `service-card--${layout}`]} data-reveal>
  <div class="service-card__meta">
    <span class="eyebrow">{String(index).padStart(2, '0')}</span>
    <span class="eyebrow">{item.code}</span>
  </div>
  <a
    class="service-card__media"
    href={item.href[locale]}
    aria-label={`${linkLabel}: ${item.title[locale]}`}
  >
    <img
      src={item.image}
      alt={item.title[locale]}
      loading={layout === 'feature' ? 'eager' : 'lazy'}
    />
    <span class="service-card__corner" aria-hidden="true">↗</span>
  </a>
  <div class="service-card__body">
    <h3>{item.title[locale]}</h3>
    <p>{item.description[locale]}</p>
    <a class="text-link" href={item.href[locale]}>
      <span>{linkLabel}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
