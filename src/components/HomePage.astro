---
import type { Locale } from '@/data/site';
import { copy, services } from '@/data/site';
import SiteHeader from './SiteHeader.astro';
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';
import ContactForm from './ContactForm.astro';
import FooterOverlay from './FooterOverlay.astro';
import '@/styles/pages/home.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = copy[locale];
const machines = services.filter((item) => item.category === 'machine');
const solutions = services.filter((item) => item.category === 'solution');
---

<SiteHeader
  locale={locale}
  brand={text.brand}
  menuLabel={text.menu}
  closeLabel={text.close}
  languageLabel={text.languageLabel}
  languageHref={text.languageHref}
  nav={text.nav}
/>

<main id="main-content">
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero__topline">
      <p class="eyebrow">{text.heroKicker}</p>
      <p class="eyebrow">IN PRODUCTION</p>
    </div>

    <div
      class="hero__tags"
      aria-label={locale === 'zh' ? '服務類型' : 'Service categories'}
    >
      {text.tags.map((tag) => (
        <a
          class:list={[
            'tag',
            'hero__tag',
            tag.featured && 'tag--featured',
            tag.tone === 'signal' && 'tag--signal',
            tag.tone === 'orange' && 'tag--orange',
          ]}
          href={tag.href}
        >
          {
            tag.featured && (
              <span class="hero__tag-featured">
                {locale === 'zh' ? '主打' : 'FEATURED'}
              </span>
            )
          }
          <span>{tag.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <h1 class="hero__title" id="hero-title">
      <span>{text.heroTitle[0]}</span>
      <span>{text.heroTitle[1]}</span>
    </h1>

    <div class="hero__lower grid-12">
      <p class="hero__deck">{text.heroDeck}</p>
      <div class="hero__actions">
        <a class="button button--ink" href="#services">
          <span>{text.heroPrimary}</span>
          <span aria-hidden="true">↓</span>
        </a>
        <a class="button button--outline" href="#contact">
          <span>{text.heroSecondary}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <figure class="hero__media">
      <img
        src="/images/B.jpg"
        alt={
          locale === 'zh'
            ? '印刷機高速運轉中的滾筒與紙張'
            : 'Paper moving through the rollers of an industrial printing press'
        }
        fetchpriority="high"
      />
      <figcaption>
        {text.heroCaption.map((line) => <span class="eyebrow">{line}</span>)}
      </figcaption>
      <span class="hero__registration-mark" aria-hidden="true">●</span>
    </figure>
  </section>

  <section class="about shell" id="about" aria-labelledby="about-title">
    <div class="about__label eyebrow">{text.aboutEyebrow}</div>
    <div class="about__content">
      <p class="section-category">{text.aboutCategory}</p>
      <h2 id="about-title">{text.aboutTitle}</h2>
      <blockquote>{text.aboutLead}</blockquote>
      <div class="about__copy">
        {text.aboutBody.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="about__stats">
      <div>
        <strong>{text.statYears}</strong>
        <span>{text.statYearsLabel}</span>
      </div>
      <div>
        <strong>{text.statScope}</strong>
        <span>{text.statScopeLabel}</span>
      </div>
    </div>
  </section>

  <section class="service-section" id="services" aria-labelledby="machines-title">
    <SectionHeading
      id="machines-title"
      eyebrow={text.machineEyebrow}
      category={text.machineCategory}
      title={text.machineTitle}
      deck={text.machineDeck}
    />
    <div class="machine-grid shell">
      {machines.map((item, index) => (
        <ServiceCard
          item={item}
          locale={locale}
          linkLabel={text.readMore}
          index={index + 1}
          layout={index === 0 ? 'feature' : 'standard'}
        />
      ))}
    </div>
  </section>

  <section class="service-section service-section--solutions" aria-labelledby="solutions-title">
    <SectionHeading
      id="solutions-title"
      eyebrow={text.solutionEyebrow}
      category={text.solutionCategory}
      title={text.solutionTitle}
      deck={text.solutionDeck}
    />
    <div class="solution-grid shell">
      {solutions.map((item, index) => (
        <ServiceCard
          item={item}
          locale={locale}
          linkLabel={text.readMore}
          index={machines.length + index + 1}
          layout={index === 0 ? 'feature' : 'standard'}
        />
      ))}
    </div>
  </section>

  <section class="contact shell grid-12" id="contact" aria-labelledby="contact-title">
    <div class="contact__intro" data-reveal>
      <p class="eyebrow">{text.contactEyebrow}</p>
      <p class="section-category">{text.contactCategory}</p>
      <h2 id="contact-title">{text.contactTitle}</h2>
      <p>{text.contactDeck}</p>
      <div class="contact__direct">
        <a href="mailto:info@jhengfong-tw.com">info@jhengfong-tw.com</a>
        <a href="tel:+886222434702">02-2243-4702</a>
      </div>
    </div>
    <div class="contact__form" data-reveal>
      <ContactForm
        locale={locale}
        fields={text.fields}
        options={text.options}
        pending={text.formPending}
        success={text.formSuccess}
        error={text.formError}
      />
    </div>
  </section>
</main>

<FooterOverlay
  locale={locale}
  openLabel={text.footerOpen}
  closeLabel={text.footerClose}
  title={text.footerTitle}
  sections={text.footerSections}
  links={text.footerLinks}
  telLabel={text.telLabel}
  timeLabel={text.timeLabel}
  timeValue={text.timeValue}
/>
